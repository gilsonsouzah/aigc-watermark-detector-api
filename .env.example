# Chave do Vercel AI Gateway (vck_...). Sem ela, a camada `jev` é pulada e o resultado sai
# apenas das camadas locais, com aviso em `warnings`.
VERCEL_AI_GATEWAY_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
JUDGE_MODEL=typesafe-ai/jev

# Limite de upload e timeout
MAX_UPLOAD_MB=25
AI_GATEWAY_TIMEOUT=60

# --- SynthID ---------------------------------------------------------------
# Detector externo de watermark (POST com os bytes da imagem, resposta {"probability": 0..1}
# ou {"detected": bool}). Preencher quando houver acesso ao portal do Google, à GetReal, ou
# à API de interoperabilidade que o Código de Prática da UE exige até 2/fev/2027.
SYNTHID_DETECTOR_URL=

# Sonda local por template: desligada por padrão. Só faz sentido com imagem(ns) sabidamente
# marcada(s), uma por escala de pixel (separar por vírgula). Contribui com peso mínimo.
SYNTHID_LOCAL_PROBE=
SYNTHID_TEMPLATE=

# --- SynthID-TEXT ---
# O padrão de TEXTO tem código aberto (google-deepmind/synthid-text, Apache-2.0) e o verificador
# está implementado em src/aiwd/synthid_text.py, provado por teste: dispara na chave certa
# (média de g 0.82) e dá chance na chave errada (0.49).
# MAS a marca é definida sobre os TOKEN IDS do tokenizador do fornecedor: sem a chave secreta E
# o tokenizador exato, detectar texto de terceiro é impossível — é limitação do esquema, não
# desta implementação. Preencha só se você for quem marca o texto.
SYNTHID_TEXT_KEYS=
SYNTHID_TEXT_TOKENIZER=

# --- Detector neural de imagem (opcional, recomendado) ---------------------
# Community Forensics ViT-S/16 em ONNX fp32 (87 MB, licença MIT). Validado contra o
# checkpoint oficial (Δ 7.3e-06). O model_int8.onnx publicado NÃO bate (Δ 0.42) — não use.
# Baixar: https://huggingface.co/buildborderless/CommunityForensics-DeepfakeDet-ViT
#         (onnx/model.onnx e pretrained_weights/model_v11_ViT_384_base_ckpt.pt)
# Validar:  python tools/validate_cf_onnx.py --torch-json /tmp/cf_torch.json --imagens <dir>
AIGC_IMAGE_MODEL_ONNX=

# --- Sonda neural comunitária (opcional) -----------------------------------
# ONNX exportado por tools/export_synthid_surrogates.py. Pesos são PolyForm Noncommercial e
# NÃO ficam no repo. Medição desta bancada: AUC 0.31-0.59 (abaixo de 0.5 justamente em imagem
# COM SynthID) — mantida desligada; ligue só para experimentar.
AIGC_PROBE_ONNX=

# Calibração medida (tools/fit_calibration.py). Sem o arquivo, o score sai sem calibração
# e a API avisa em `warnings`.
AIGC_CALIBRATION=calibration.json

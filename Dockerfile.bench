# Bancada em sandbox: roda medição pesada fora da máquina, com limite de CPU/memória.
# Nada de I/O com o sistema além do projeto montado em /app.
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[onnx]"

ENV PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    AIGC_CALIBRATION=/app/calibration.json

CMD ["python", "-m", "tools.measure", "--n-reais", "50"]
